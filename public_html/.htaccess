# ---------------------------------------------------------------------------
# Boldex Technologies — Apache / LiteSpeed settings (cPanel, Hostinger, etc.)
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Force HTTPS and the www address.
# Remove the "#" from the four lines below ONLY after the SSL certificate for
# www.boldextechnologies.com.ng is active (cPanel → SSL/TLS Status), otherwise
# visitors will see a security warning.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.boldextechnologies.com.ng%{REQUEST_URI} [L,R=301]
# </IfModule>

# Old WordPress addresses → closest new page (keeps Google links and bookmarks working).
RedirectMatch 301 ^/blog/?$ /
RedirectMatch 301 ^/hello-world/?$ /
RedirectMatch 301 ^/how-to-configure-wordpress-to-use-smtp-for-sending-emails/?$ /services/web-development/
RedirectMatch 301 ^/category/.*$ /
RedirectMatch 301 ^/feed/?$ /
RedirectMatch 301 ^/index\.php$ /

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# File types
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddDefaultCharset utf-8
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Browser caching. CSS/JS links carry a ?v= number — change it in the HTML after editing those files.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
